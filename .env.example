# ── Backend (backend/.env) ─────────────────────────────────────────
# Never commit real values. See docs/security/secrets-management.md
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=<openssl rand -hex 32>
SERVICE_KEY=<openssl rand -hex 32>            # shared with ml-service

# Providers and storage. Every one is OPTIONAL even in production — each
# integration reports its own absence honestly instead of failing the boot
# (docs/deployment/environment.md).
GEMINI_API_KEY=<from Google AI Studio - free tier>
OPENROUTER_API_KEY=<optional tertiary vision fallback>
GROQ_API_KEY=<optional P2 voice transcribe - not read by any code yet>
OPENWEATHER_API_KEY=<weather fallback>
DATAGOVIN_API_KEY=<data.gov.in registration>
DATAGOVIN_RESOURCE_ID=<data.gov.in resource id for Variety-wise Daily Market Prices>
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>
ML_SERVICE_URL=https://<ml-service-host>

# Operator kill switches — routing-layer only, and HONOURED IN PRODUCTION:
# they exist to shed a quota-exhausted or misbehaving tier without a redeploy.
DISABLE_ML=false
DISABLE_GEMINI=false
DISABLE_OPENROUTER=false

# Non-prod only — failure injection (inert when NODE_ENV=production):
# FORCE_FAIL_OPENMETEO / OPENWEATHER / DATAGOVIN / ML / GEMINI / OPENROUTER /
# CLOUDINARY = true, FORCE_FAIL_WEATHER=true (both weather providers),
# FORCE_SLOW_<SVC>=<ms>

# ── ml-service (ml-service/.env) ───────────────────────────────────
SERVICE_KEY=<same as backend SERVICE_KEY>     # required in every environment
ENV=development                               # development | test | production
# All of the following are optional:
# MODEL_PATH=<path to the .onnx artefact; unset => untrained StubPredictor>
# MODEL_VERSION=<overrides the manifest value; unset => manifest>
# MODEL_MANIFEST_PATH=model/model-manifest.json
# PORT=7860
# LOG_LEVEL=INFO
# REQUEST_TIMEOUT_SECONDS=10.0

# ── Web (web/frontend/.env) — public by definition, no secrets ─────
VITE_API_URL=http://localhost:4000/api/v1

# ── Mobile (mobile/.env) — public by definition, no secrets ────────
EXPO_PUBLIC_API_URL=http://<lan-ip>:4000/api/v1

# ── Scripts only ───────────────────────────────────────────────────
SEED_DEMO_PASSWORD=<password for seeded demo farmer>
