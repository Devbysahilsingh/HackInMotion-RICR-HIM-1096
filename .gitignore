# ── Secrets (never commit; .env.example is tracked instead) ────────
.env
.env.*
!.env.example
*.pem
*.key
!**/public/**/*.key

# ── Dependencies ───────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Build output ───────────────────────────────────────────────────
dist/
build/
.vite/
*.tsbuildinfo

# ── Datasets & model artifacts (see datasets/README.md) ────────────
# Raw data and archives stay out of git; the small provenance records
# (manifest + captured licence texts) are committed for compliance.
datasets/*
!datasets/README.md
!datasets/manifest.json
!datasets/manifest-raw.json
!datasets/audit-report.json
!datasets/confound-report.json
!datasets/licenses/
!datasets/lookup/
# datasets/audit/ (contact sheets + hash cache) stays ignored: derived image
# data, regenerable from the raw sets by scripts/ml/audit-datasets.py.
*.onnx
# The shipped inference artefact IS committed: docs/ml/model-versioning.md —
# "artifacts in ml-service repo dir via Git LFS if >100MB (ours ~20MB — plain
# git fine); every deployed version tagged model-vX.Y". It is baked into the
# service image, so it has to travel with the repo. Training checkpoints (*.pt)
# stay ignored — they are 26MB each, per-epoch, and regenerable.
!ml-service/model/*.onnx
*.pt
*.pth
*.ckpt

# ── Python (ml-service, training) ──────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ── Test & coverage output ─────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ── Logs ───────────────────────────────────────────────────────────
*.log
npm-debug.log*
logs/

# ── Editors / OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Mobile (Expo, added in Phase 6) ────────────────────────────────
.expo/
*.apk
*.aab

# ── AI / planning working files (not product source) ───────────────
# Context-handoff prompts written to brief a fresh Claude session. Working
# scaffolding for how the project was built, not documentation of what it is —
# docs/ai/prompt-strategy.md (the Gemini vision prompt design) is a real design
# record and stays tracked, as do CLAUDE.md, MASTER-TODO.md and the
# implementation log.
docs/promt

# Per-machine Claude Code settings (allow-lists, local overrides). Previously
# ignored only by this machine's *global* git ignore, so a teammate cloning the
# repo would have committed theirs. The shared .claude/settings.json is tracked.
.claude/settings.local.json
