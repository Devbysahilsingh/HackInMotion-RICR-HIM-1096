# ── Secrets (never commit; .env.example is tracked instead) ────────
.env
.env.*
!.env.example
*.pem
*.key
!**/public/**/*.key

# ── Dependencies ───────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Build output ───────────────────────────────────────────────────
dist/
build/
.vite/
*.tsbuildinfo

# ── Datasets & model artifacts (see datasets/README.md) ────────────
# Raw data and archives stay out of git; the small provenance records
# (manifest + captured licence texts) are committed for compliance.
datasets/*
!datasets/README.md
!datasets/manifest.json
!datasets/manifest-raw.json
!datasets/audit-report.json
!datasets/confound-report.json
!datasets/licenses/
!datasets/lookup/
# datasets/audit/ (contact sheets + hash cache) stays ignored: derived image
# data, regenerable from the raw sets by scripts/ml/audit-datasets.py.
*.onnx
*.pt
*.pth
*.ckpt

# ── Python (ml-service, training) ──────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ── Test & coverage output ─────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ── Logs ───────────────────────────────────────────────────────────
*.log
npm-debug.log*
logs/

# ── Editors / OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Mobile (Expo, added in Phase 6) ────────────────────────────────
.expo/
*.apk
*.aab
