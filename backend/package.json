{
  "name": "him-1096-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for the Smart Farm Decision Support System (HIM-1096)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "lint": "eslint src tests scripts",
    "test": "node --import ./tests/env.mjs --test tests/",
    "test:watch": "node --import ./tests/env.mjs --test --watch tests/",
    "indexes:build": "node --env-file=.env scripts/build-indexes.mjs",
    "seed:registry": "node --env-file=.env scripts/seed-registry.mjs",
    "smoke": "node scripts/smoke.mjs",
    "seed:market": "node --env-file=.env scripts/seed-market.mjs",
    "jobs": "node --env-file=.env scripts/trigger-jobs.mjs",
    "seed:dev": "node --env-file=.env scripts/seed-dev.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "express-rate-limit": "^8.6.2",
    "file-type": "^21.3.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.3",
    "multer": "^2.2.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.0.0"
  }
}
